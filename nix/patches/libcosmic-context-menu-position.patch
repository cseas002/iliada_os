+/// Where the pointer last was in each window, in window coordinates. A text
+/// widget inside a scrolled area sees the pointer in the scrolled content's
+/// coordinates, which put its popup off by the scroll offset (often at the
+/// bottom of the screen); the popup is anchored here instead.
+#[cfg(wayland_platform)]
+static POINTER: Mutex<Option<(window::Id, Point)>> = Mutex::new(None);
+
+/// Records [`POINTER`] from the windows' own pointer events.
+#[cfg(all(wayland_platform, target_os = "linux"))]
+pub(crate) fn pointer_subscription<Message: Send + 'static>()
+-> iced_futures::Subscription<crate::Action<Message>> {
+    iced::event::listen_with(|event, _status, id| {
+        if let iced_core::Event::Mouse(mouse::Event::CursorMoved { position }) = event {
+            if let Ok(mut pointer) = POINTER.lock() {
+                *pointer = Some((id, position));
+            }
+        }
+        None
+    })
+}
