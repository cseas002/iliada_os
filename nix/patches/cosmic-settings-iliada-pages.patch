diff --git a/cosmic-settings/src/pages/iliada.rs b/cosmic-settings/src/pages/iliada.rs
new file mode 100644
index 0000000..cc859ba
--- /dev/null
+++ b/cosmic-settings/src/pages/iliada.rs
@@ -0,0 +1,97 @@
+// Iliada's settings pages (the Iliada account, privacy, Homer, updates,
+// backup, services, command-line tools, about) among COSMIC's own, so the
+// computer has one Settings app. Each page shows Iliada's panel
+// (iliada_settings::panel) for that page.
+
+use cosmic::Task;
+use cosmic_settings_page::{self as page, Section, section};
+use iliada_settings::panel::{self, Page as IliadaPage, Panel};
+use slotmap::SlotMap;
+
+/// An Iliada page's message, as COSMIC Settings carries it.
+fn wrap(page: IliadaPage, task: cosmic::app::Task<panel::Message>) -> Task<crate::pages::Message> {
+    task.map(move |action| match action {
+        cosmic::Action::App(m) => crate::pages::Message::Iliada(page, m),
+        _ => crate::pages::Message::IliadaNothing,
+    })
+}
+
+fn wrap_app(page: IliadaPage, task: cosmic::app::Task<panel::Message>) -> cosmic::app::Task<crate::Message> {
+    task.map(move |action| match action {
+        cosmic::Action::App(m) => cosmic::Action::App(crate::pages::Message::Iliada(page, m).into()),
+        cosmic::Action::Cosmic(c) => cosmic::Action::Cosmic(c),
+        _ => cosmic::Action::None,
+    })
+}
+
+macro_rules! iliada_page {
+    ($name:ident, $page:expr) => {
+        pub struct $name {
+            panel: Panel,
+        }
+
+        impl Default for $name {
+            fn default() -> Self {
+                Self { panel: Panel::new($page) }
+            }
+        }
+
+        impl page::AutoBind<crate::pages::Message> for $name {}
+
+        impl page::Page<crate::pages::Message> for $name {
+            fn info(&self) -> page::Info {
+                page::Info::new(format!("iliada-{}", $page.id()), $page.icon())
+                    .title($page.title())
+                    .description($page.description())
+            }
+
+            fn content(
+                &self,
+                sections: &mut SlotMap<section::Entity, Section<crate::pages::Message>>,
+            ) -> Option<page::Content> {
+                Some(vec![sections.insert(Section::default().view::<$name>(|_binder, page, _section| {
+                    page.panel.content().map(|m| crate::pages::Message::Iliada($page, m))
+                }))])
+            }
+
+            fn dialog(&self) -> Option<cosmic::Element<'_, crate::pages::Message>> {
+                self.panel.dialog().map(|e| e.map(|m| crate::pages::Message::Iliada($page, m)))
+            }
+
+            fn on_enter(&mut self) -> Task<crate::pages::Message> {
+                wrap($page, self.panel.enter($page))
+            }
+        }
+    };
+}
+
+iliada_page!(Account, IliadaPage::Account);
+iliada_page!(Privacy, IliadaPage::Privacy);
+iliada_page!(Homer, IliadaPage::Assistant);
+iliada_page!(Updates, IliadaPage::Updates);
+iliada_page!(Backup, IliadaPage::Backup);
+iliada_page!(Services, IliadaPage::Services);
+iliada_page!(Tools, IliadaPage::Tools);
+iliada_page!(About, IliadaPage::About);
+
+/// A message for one of Iliada's pages.
+pub fn update(
+    pages: &mut page::Binder<crate::pages::Message>,
+    page: IliadaPage,
+    message: panel::Message,
+) -> cosmic::app::Task<crate::Message> {
+    let panel = match page {
+        IliadaPage::Account => pages.page_mut::<Account>().map(|p| &mut p.panel),
+        IliadaPage::Privacy => pages.page_mut::<Privacy>().map(|p| &mut p.panel),
+        IliadaPage::Assistant => pages.page_mut::<Homer>().map(|p| &mut p.panel),
+        IliadaPage::Updates => pages.page_mut::<Updates>().map(|p| &mut p.panel),
+        IliadaPage::Backup => pages.page_mut::<Backup>().map(|p| &mut p.panel),
+        IliadaPage::Services => pages.page_mut::<Services>().map(|p| &mut p.panel),
+        IliadaPage::Tools => pages.page_mut::<Tools>().map(|p| &mut p.panel),
+        IliadaPage::About => pages.page_mut::<About>().map(|p| &mut p.panel),
+    };
+    match panel {
+        Some(panel) => wrap_app(page, panel.update(message)),
+        None => Task::none(),
+    }
+}
