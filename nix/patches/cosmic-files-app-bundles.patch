 /// Creates an icon handle from a desktop file's Icon field value.
 /// Supports both icon names (looked up in theme) and absolute paths (used directly).
+/// Iliada: a directory `Name.app` containing `Contents/Info.toml` is an
+/// application bundle. It is shown and opened like an app, not a folder.
+pub fn is_app_bundle(path: &Path) -> bool {
+    path.extension().is_some_and(|e| e == "app") && path.join("Contents/Info.toml").is_file()
+}
+
+/// Iliada: the bundle's own icon, or a generic application icon.
+fn app_bundle_icon(path: &Path, size: u16) -> widget::icon::Handle {
+    for name in ["icon.svg", "icon.png"] {
+        let icon = path.join("Contents/Resources").join(name);
+        if icon.is_file() {
+            return widget::icon::from_path(icon);
+        }
+    }
+    widget::icon::from_name("application-x-executable")
+        .prefer_svg(true)
+        .size(size)
+        .handle()
+}
