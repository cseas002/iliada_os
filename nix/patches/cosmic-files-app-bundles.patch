     fn open_file(&mut self, paths: &[impl AsRef<Path>]) -> Task<Message> {
+        // Iliada: application bundles are launched in their sandbox; anything
+        // else continues through the normal path below.
+        if paths.iter().any(|p| crate::tab::is_app_bundle(p.as_ref())) {
+            let mut rest: Vec<PathBuf> = Vec::new();
+            for p in paths {
+                let p = p.as_ref();
+                if crate::tab::is_app_bundle(p) {
+                    let mut command = std::process::Command::new("iliada-run");
+                    command.arg(p);
+                    if let Err(err) = spawn_detached(&mut command) {
+                        log::warn!("failed to launch {}: {}", p.display(), err);
+                    }
+                } else {
+                    rest.push(p.to_owned());
+                }
+            }
+            return if rest.is_empty() { Task::none() } else { self.open_file(&rest) };
+        }
